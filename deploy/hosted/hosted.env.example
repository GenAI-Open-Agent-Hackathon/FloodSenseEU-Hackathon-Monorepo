# Copy to deploy/hosted/hosted.env (git-ignored) and fill the blanks. Never commit the copy.
# Values containing $ MUST stay in single quotes (the bcrypt hash does).

# --- Public entry -----------------------------------------------------------
# ":80" = plain HTTP on the VM's port 80. A domain (DNS A record -> VM IP) = automatic HTTPS.
SITE_ADDRESS=:80
# Judge login. Generate with: python scripts/hosted_auth.py
JUDGE_USER=judge
JUDGE_HASH=

# --- Secrets (from the Nebius console / Tavily) ------------------------------
NEBIUS_API_KEY=
TAVILY_API_KEY=
# Required to touch control-tower switches (the proxy also blocks them). Any long random string.
WATCH_ADMIN_TOKEN=

# --- Model backend -----------------------------------------------------------
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_DEEP=nvidia/Nemotron-3.5-Super-VL

# --- Caps (see docs/DEPLOY-NEBIUS.md "Caps") ---------------------------------
# Runs per minute per client IP. Behind the proxy every judge shares the proxy IP,
# so this is effectively a GLOBAL limit. 0 would switch it off: do not.
RATE_LIMIT_RUNS_PER_MIN=4
RATE_LIMIT_MAX_CONCURRENT_RUNS=2
# Model calls in flight and starts per minute (process-wide, agents service).
NIGHTSHIFT_MAX_CONCURRENCY=2
NIGHTSHIFT_RPM=20
# Completion-token ceilings per call (hidden reasoning counts).
LLM_MAX_TOKENS_FAST=4000
LLM_MAX_TOKENS_DEEP=5000
SKEPTIC_MAX_ROUNDS=1
JUDGE_REPAIR_ROUNDS=0
# Control tower scan interval (rule-based, no model calls). Auto-assess is forced off in the compose file.
WATCH_INTERVAL_S=1800
