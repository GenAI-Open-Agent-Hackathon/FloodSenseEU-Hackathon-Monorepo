# Shared site body (snippet). Imported by Caddyfile.https / .selfsigned / .http.
(app) {
	encode zstd gzip

	# Unauthenticated liveness for uptime checks. Reveals nothing.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		basic_auth {
			{$JUDGE_USER} {$JUDGE_HASH}
		}

		# Request size cap: a question is a few hundred bytes.
		request_body {
			max_size 32KB
		}

		# /api/* -> API with the prefix stripped (the UI is built with VITE_API_URL=/api).
		handle_path /api/* {
			# Operator-only switches are unreachable from the public URL.
			@admin path /watch/auto-assess /watch/cycle
			handle @admin {
				respond "disabled on the hosted demo" 403
			}
			reverse_proxy api:8000 {
				flush_interval -1
			}
		}

		# Production UI build baked into the image, SPA fallback to index.html.
		handle {
			root * /srv
			# The page shell must not be cached. A browser that shows it from cache
			# never meets the login, then sends a stale password with every API call
			# and gets 401s (the page reads "Live data unavailable"). Assets are
			# content-hashed, so they stay cacheable.
			@shell not path /assets/*
			header @shell Cache-Control "no-store"
			try_files {path} /index.html
			file_server
		}
	}
}
