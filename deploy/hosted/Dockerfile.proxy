# Context: ./ui. Builds the UI for production and serves it from Caddy (no Vite dev server).
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Same-origin: the proxy maps /api/* to the API.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npx vite build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
