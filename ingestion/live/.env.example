# Copy to ingestion/live/.env. `python tasks.py init-env` does that when the
# copy is missing and does not overwrite it. Never commit the copy.
#
# ASCII aliases are accepted for the two names that need umlauts:
# KOELN -> KÖLN, DUESSELDORF or DUSSELDORF -> DÜSSELDORF.
# Keep this file UTF-8 if you write the umlauts yourself. PowerShell 5
# Set-Content can write UTF-16; do not re-save this example that way.

PEGELONLINE_BASE_URL=https://pegelonline.wsv.de/webservices/rest-api/v2
PEGELONLINE_STATIONS=KAUB,KOBLENZ,ANDERNACH,BONN,KOELN,DUESSELDORF
PEGELONLINE_TIMESERIES=W
PEGELONLINE_LOOKBACK=P1D
PEGELONLINE_INTERVAL_SECONDS=900
PEGELONLINE_TIMEOUT_SECONDS=20
PEGELONLINE_MAX_RETRIES=3
PEGELONLINE_BACKOFF_SECONDS=1
PEGELONLINE_REQUEST_PAUSE_SECONDS=0.25
PEGELONLINE_ALL_CURRENT=0
PEGELONLINE_USER_AGENT=FloodSenseEU/0.1 (PEGELONLINE poller)

# Same database as the compose `rag` profile (pgvector), host port 15432.
# Match POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB to pgvector/.env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=floodsense
POSTGRES_USER=floodsense
POSTGRES_PASSWORD=local-dev-only
POSTGRES_SSLMODE=disable

# Read by the Zetaris migration, not by the poller. Put the same three
# variables in ingestion/.env when `zetaris-sync` learns to substitute them.
# The sync tool is still a stub; until then paste them into the SQL editor.
#
# Zetaris container joined to the compose network floodsense-app-net:
# FLOODSENSE_PG_JDBC_URL=jdbc:postgresql://pgvector:5432/floodsense?currentSchema=live
# Docker Desktop on Windows, via the published host port (bound to 127.0.0.1):
# FLOODSENSE_PG_JDBC_URL=jdbc:postgresql://host.docker.internal:15432/floodsense?currentSchema=live
FLOODSENSE_PG_JDBC_URL=
