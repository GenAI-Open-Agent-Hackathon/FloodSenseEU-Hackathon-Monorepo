# FloodSense EU — root environment.
# Copy to .env (git-ignored) and fill in locally. This file has placeholders only.
#
# The NVIDIA provider key is not an application environment variable.
# It lives only in Nightshift's Providers tab. Do not add it here, in any
# service env, in git, or in Cursor model settings.

# Published host ports for OUR compose project (name: floodsense-app).
# Zetaris keeps UI :3000, REST :8888, JDBC :10000. Nightshift keeps :8088.
FLOODSENSE_API_PORT=18000
FLOODSENSE_UI_PORT=15173
FLOODSENSE_PGVECTOR_PORT=15432
FLOODSENSE_REDIS_PORT=16379

# Empty -> the API uses an in-process cache.
# With `docker compose --profile cache up`: REDIS_URL=redis://redis:6379/0
REDIS_URL=

# Zetaris. Each person runs their own stack. This repo never starts it.
# From a container, use host.docker.internal. From the host, use 127.0.0.1.
ZETARIS_REST_URL=http://host.docker.internal:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_JDBC_URL=
ZETARIS_USER=
ZETARIS_PASSWORD=

# Meterless Nightshift, OpenAI-compatible gateway.
# Every call sends:
#   Authorization: Bearer <METERLESS_RUNTIME_TOKEN>
#   meterless-app: <METERLESS_APP>
#   meterless-scope: user
METERLESS_BASE_URL=http://host.docker.internal:8088/v1
METERLESS_APP=floodsense-eu
METERLESS_SCOPE=user
METERLESS_RUNTIME_TOKEN=

MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_DEEP=nvidia/nemotron-3-super-120b-a12b
LLM_TIMEOUT_S=180
