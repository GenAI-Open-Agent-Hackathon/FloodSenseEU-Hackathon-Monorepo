# FloodSense EU — root environment.
# Copy to .env (git-ignored). Docker Compose reads this file only to
# interpolate the ports below. It does not inject this file into containers.
#
# The NVIDIA provider key is not an application environment variable.
# It lives only in Nightshift's Providers tab. Do not add it here, in any
# service env, in git, or in Cursor model settings.

# Published host ports for OUR compose project (name: floodsense-app).
# Bound to 127.0.0.1. Zetaris keeps UI :3000, REST :8888, JDBC :10000.
# Nightshift keeps :8088. The engines sidecar publishes FLOODSENSE_ENGINES_PORT.
# Agents inside compose call http://engines:8300. On the host that service
# is http://127.0.0.1:8300. See engines/README.md.
FLOODSENSE_API_PORT=18000
FLOODSENSE_UI_PORT=15173
FLOODSENSE_ENGINES_PORT=8300
FLOODSENSE_PGVECTOR_PORT=15432
FLOODSENSE_REDIS_PORT=16379
# Local data backend (profile local-data, `python tasks.py up-local`): Postgres host port
# and how often the loader polls PEGELONLINE (Open-Meteo is polled at most every 30 min).
FLOODSENSE_LOCALDB_PORT=15433
LOCAL_REFRESH_S=600

# Do not set REDIS_URL here. With the cache profile, set it in api/.env:
# REDIS_URL=redis://redis:6379/0
# Compose must not forward a root value: an empty interpolation overwrites
# whatever was written in api/.env.

# Host-side Zetaris and Nightshift settings. scripts/nightshift_check.py reads the
# Nightshift lines below; nothing else loads this file yet.
# Containers use agents/.env, whose URLs are host.docker.internal.
# Host commands (ingestion, and later python tasks.py zetaris-sync) use ingestion/.env.
# host.docker.internal usually does not resolve on the host, so the values
# below are the host URLs (127.0.0.1), not the container URLs.
ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_JDBC_URL=
ZETARIS_USER=
ZETARIS_PASSWORD=

METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_APP=floodsense-eu
METERLESS_SCOPE=user
METERLESS_RUNTIME_TOKEN=

# Routing modes. These two values are what the app sends. Nightshift picks
# the model: Nemotron 3.5 Lightning 30B A3B on both lanes in the 27 Oct runs. Neither is the value of MODEL_FAST. The model that answered is logged on
# the trace. The one map from mode to model id is in docs/architecture/c4.md.
MODEL_FAST=meterless/fast
MODEL_DEEP=meterless/deep

# LLM backend: nightshift (default) | nebius (Nebius Token Factory, NVIDIA Nemotron).
# With nebius, NEBIUS_API_KEY is required (startup fails without it); MODEL_FAST/MODEL_DEEP are ignored.
LLM_BACKEND=nightshift
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_DEEP=nvidia/Nemotron-3.5-Super-VL
LLM_TIMEOUT_S=180

# Read only by scripts/nightshift_check.py. The model each tier should be
# answered by; empty means Nemotron 3.5 Super VL 120B A12B for both, and "any"
# accepts whichever model answers.
EXPECT_MODEL_FAST=
EXPECT_MODEL_DEEP=
# Embedding model id to probe for the semantic cache; empty picks one from /models.
MODEL_EMBED=
