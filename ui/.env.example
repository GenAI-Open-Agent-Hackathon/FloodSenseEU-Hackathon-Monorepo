# Copy to ui/.env. Vite exposes VITE_* values to the browser.
# Do not put Zetaris keys, the Nightshift token, or any other secret here.
#
# The NVIDIA provider key is not an application environment variable.
# It lives only in Nightshift's Providers tab.

VITE_API_URL=http://localhost:18000

# Optional. Base map tiles (HTTPS). Defaults to the public OpenStreetMap tile
# server. If you change the URL, change the attribution to match the provider.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>

# Optional. "mock" never calls PEGELONLINE (offline demo). Default: live.
# VITE_GAUGE_FEED=live
